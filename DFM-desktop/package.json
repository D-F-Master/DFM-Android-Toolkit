{
  "name": "dfm-desktop",
  "version": "2.0.0",
  "description": "DFM-Android-Toolkit 桌面端（Electron 壳 + DFM-service 后端）",
  "main": "main.js",
  "author": "DFM",
  "scripts": {
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "sync": "node scripts/sync-frontend.js",
    "start": "electron .",
    "pack": "electron-builder --win nsis --publish never",
    "pack:dir": "electron-builder --win nsis --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dfm.android-toolkit",
    "productName": "DFM-Android-Toolkit",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../DFM-service/dist/ylx-utools-server",
        "to": "backend"
      }
    ],
    "afterPack": "scripts/afterPack.js",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DFM-Android-Toolkit"
    },
    "publish": {
      "provider": "generic",
      "url": "http://localhost:8080/updates/"
    }
  }
}
