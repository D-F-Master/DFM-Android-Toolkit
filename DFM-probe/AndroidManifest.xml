<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dfm.probe"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="30" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 11 (targetSdk 30) 包可见性限制：不声明就 bind 不上系统 TTS 引擎服务，
         TextToSpeech 构造会立刻回调 onInit(ERROR) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_probe"
        android:allowBackup="false">

        <receiver
            android:name=".ConnectReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dfm.probe.CONNECT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ProbeService"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>
